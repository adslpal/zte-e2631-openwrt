# SPDX-License-Identifier: GPL-2.0-only
#
# H60G additions. apply-board.sh below makes the base target/linux/sanechips/
# image/Makefile include this file. Modelled on the E2631 Makefile so the
# ZX279128S kernel/uImage/dtb packaging chain is identical.
#
# NOTE: no factory.bin here -- H60G's stock upgrade format is unknown. We build
# sysupgrade.bin only, and flash it by raw NAND write into the "rootfs"
# partition from U-Boot/TFTP. Once the vendor upgrade format is reverse-
# engineered, a Build/h60g-factory can be added like E2631's.

# ---------------------------------------------------------------------------
# REV4: ramboot uImage load/entry address moved from 0x48008000 to 0x4C000000.
#
# CONFIG_AUTO_ZRELADDR makes the zImage unpack to (pc & 0xF8000000) + 0x8000.
# Entering at 0x48008000 therefore unpacks AT 0x48008000 -- the same address
# the compressed image occupies. On this board the decompressed kernel is
# 47.5 MiB while the compressed payload is only 14.1 MiB, so the decompressor
# overwrites its own unread input and dies without printing a single byte.
# (The E2631 image is small enough not to hit this; ours is not.)
#
# Entering at 0x4C000000:
#     0x4C000000 & 0xF8000000 = 0x48000000
#     + 0x8000                = 0x48008000   <- unpack target unchanged,
#                                              still above U-Boot's ethernet
#                                              DMA buffers at 0x41000000
#     compressed [0x4C000000, 0x4CE15239)
#     unpacked   [0x48008000, 0x4AF94C40)    <- zero overlap, ~17 MiB gap
# ---------------------------------------------------------------------------
define Build/uImage-ramboot-h60g
	$(if $(UIMAGE_TIME),SOURCE_DATE_EPOCH="$(UIMAGE_TIME)") \
	mkimage -A $(LINUX_KARCH) -O linux -T kernel -C none \
		-a 0x4c000000 -e 0x4c000000 \
		-n '$(call toupper,$(LINUX_KARCH)) $(VERSION_DIST) Linux-$(LINUX_VERSION)' \
		-d $@ $@.new
	mv $@.new $@
endef

define Device/zte_h60g
  DEVICE_VENDOR := ZTE
  DEVICE_MODEL := H60G
  DEVICE_DTS := zx279128s-zte-h60g
  DEVICE_DTS_DIR := $(TOPDIR)/target/linux/sanechips/dts
  # No A/B slot header on the stock ONU: plain uImage, rootfs appended.
  # KERNEL_SIZE must be changed to match the real rootfs partition in the DTS.
  KERNEL_SIZE := 4096k
  KERNEL := kernel-bin | append-dtb | uImage none | check-size $$(KERNEL_SIZE)
  KERNEL_INITRAMFS := kernel-bin | append-dtb | uImage-ramboot-h60g
  # Pure wired router: LuCI + PPPoE, no WiFi kmods, no mesh, no extroot.
  DEVICE_PACKAGES := \
	kmod-nft-offload \
	luci luci-i18n-base-zh-cn luci-proto-ppp luci-app-ttyd ttyd \
	luci-theme-argon luci-theme-bootstrap \
	libustream-mbedtls
  IMAGES := sysupgrade.bin
  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
endef
TARGET_DEVICES += zte_h60g
